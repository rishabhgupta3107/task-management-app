# Copy to `.env` and fill in. Compose auto-loads `.env` from this directory.
#   cp .env.example .env
#   # then set a strong secret, e.g.:
#   #   JWT_SECRET=$(openssl rand -base64 48)

# Required: signing key for JWTs (must be long/random, >= 32 chars).
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: SMTP for scheduled report emails (leave unset to disable sending).
# SMTP_PASSWORD=your-smtp-password
